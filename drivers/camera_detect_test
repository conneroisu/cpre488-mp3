#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <stdint.h>
#include <sys/mman.h>

// Constants
#define FRAME_BUFFER_ADDR 0x10000000
#define FRAME_BUFFER_WRITE_ADDR 0x10000000 + (1920*1080*2) // Second buffer for writing
#define VDMA_BASE_ADDR 0x43000000
#define LAUNCHER_NODE "/dev/miss_launch0"

// Launcher commands
#define LAUNCHER_FIRE   0x10
#define LAUNCHER_STOP   0x20
#define LAUNCHER_UP     0x02
#define LAUNCHER_DOWN   0x01
#define LAUNCHER_LEFT   0x04
#define LAUNCHER_RIGHT  0x08

// Detection parameters - edit for a different color
#define TARGET_Y_MIN    35
#define TARGET_Y_MAX    42    // Luminance range
#define TARGET_U_MIN    117   // Chrominance (red)
#define TARGET_U_MAX    125
#define TARGET_V_MIN    140
#define TARGET_V_MAX    150   // Chrominance (blue)

// Highlight color (bright green in YUV)
#define HIGHLIGHT_Y 0x80
#define HIGHLIGHT_U 0x00
#define HIGHLIGHT_V 0x00

typedef struct {
    uint32_t x;
    uint32_t y;
    uint32_t count;
} Target;

void launcher_cmd(int fd, int cmd);
int detect_target(uint16_t (*frame)[1920], uint16_t (*output)[1920], Target* target);
void aim_and_fire(int fd, Target* target);

int main() {
    int fd_launcher = open(LAUNCHER_NODE, O_RDWR);
    if (fd_launcher == -1) {
        perror("Failed to open launcher");
        return 1;
    }

    // Map frame buffers
    int mem_fd = open("/dev/mem", O_RDWR);
    
    // Read buffer
    uint16_t (*frame)[1920] = mmap(NULL, 1920*1080*2, PROT_READ, MAP_SHARED, mem_fd, FRAME_BUFFER_ADDR);
    if (frame == MAP_FAILED) {
        perror("Failed to map frame buffer");
        close(fd_launcher);
        return 1;
    }

    // Write buffer (for highlighting)
    uint16_t (*output)[1920] = mmap(NULL, 1920*1080*2, PROT_WRITE, MAP_SHARED, mem_fd, FRAME_BUFFER_WRITE_ADDR);
    if (output == MAP_FAILED) {
        perror("Failed to map output buffer");
        munmap(frame, 1920*1080*2);
        close(fd_launcher);
        return 1;
    }

    Target target = {0};
    
    while (1) {
        // Clear output buffer (optional)
        // memset(output, 0, 1920*1080*2);
        
        if (detect_target(frame, output, &target)) {
            printf("Target detected at (%u, %u) with %u pixels\n", 
                  target.x, target.y, target.count);
            aim_and_fire(fd_launcher, &target);
        } else {
            usleep(100000);
        }
    }

    munmap(frame, 1920*1080*2);
    munmap(output, 1920*1080*2);
    close(fd_launcher);
    return 0;
}

int detect_target(uint16_t (*frame)[1920], uint16_t (*output)[1920], Target* target) {
    uint64_t x_sum = 0, y_sum = 0;
    uint32_t count = 0;
    
    // Scan entire frame for target color
    for (int y = 0; y < 1080; y++) {
        for (int x = 0; x < 1728; x += 2) {
            uint16_t pixel1 = frame[y][x];
            uint16_t pixel2 = frame[y][x+1];
            
            // Extract YUV components
            uint8_t y1 = pixel1 & 0xFF;
            uint8_t u = (pixel1 >> 8) & 0xFF;
            uint8_t y2 = pixel2 & 0xFF;
            uint8_t v = (pixel2 >> 8) & 0xFF;
            
            // Copy original pixels to output
            output[y][x] = pixel1;
            output[y][x+1] = pixel2;
            
            // Detect target color
            if (y1 > TARGET_Y_MIN && y1 < TARGET_Y_MAX &&
                u > TARGET_U_MIN && u < TARGET_U_MAX &&
                v > TARGET_V_MIN && v < TARGET_V_MAX) {
                x_sum += x;
                y_sum += y;
                count++;
                
                // Highlight detected pixels (bright green)
                output[y][x] = HIGHLIGHT_Y | (HIGHLIGHT_U << 8);
                output[y][x+1] = HIGHLIGHT_Y | (HIGHLIGHT_V << 8);
            }
        }
    }

    printf("Picture analyzed - %u target pixels found\n", count);

    // Minimum pixel threshold
    if (count > 1000) { 
        target->x = x_sum / count;
        target->y = y_sum / count;
        target->count = count;
        return 1;
    }
    return 0;
}

void aim_and_fire(int fd, Target* target) {
    const uint32_t center_x = 1920 / 2;
    const uint32_t center_y = 1080 / 2;
    
    int x_offset = (int)target->x - (int)center_x;
    int y_offset = (int)target->y - (int)center_y;
    
    printf("Target at (%d, %d) - Offset (%d, %d)\n", 
           (int)target->x, (int)target->y, x_offset, y_offset);

    if (x_offset > 50) {
        launcher_cmd(fd, LAUNCHER_LEFT);
        usleep(abs(x_offset) * 100);
        launcher_cmd(fd, LAUNCHER_STOP);
        printf("Moving LEFT\n");
    } 
    else if (x_offset < -50) {
        launcher_cmd(fd, LAUNCHER_RIGHT);
        usleep(abs(x_offset) * 100);
        launcher_cmd(fd, LAUNCHER_STOP);
        printf("Moving RIGHT\n");
    }
    
    if (y_offset < -50) {
        launcher_cmd(fd, LAUNCHER_UP);
        usleep(abs(y_offset) * 100);
        launcher_cmd(fd, LAUNCHER_STOP);
        printf("Moving UP\n");
    } 
    else if (y_offset > 50) {
        launcher_cmd(fd, LAUNCHER_DOWN);
        usleep(abs(y_offset) * 100);
        launcher_cmd(fd, LAUNCHER_STOP);
        printf("Moving DOWN\n");
    }
    
    // Fire if centered
    if (abs(x_offset) < 50 && abs(y_offset) < 50) {
        printf("Firing!\n");
        launcher_cmd(fd, LAUNCHER_FIRE);
        usleep(2000000); // Wait for firing to complete
    }
}

void launcher_cmd(int fd, int cmd) {
    int retval = write(fd, &cmd, 1);
    if (retval != 1) {
        if (retval < 0) {
            perror("Command failed");
        }
    }
}
