prefix=${pcfiledir}/../../../usr
exec_prefix=${pcfiledir}/../../../usr
libdir=${pcfiledir}/../../../usr/lib
includedir=${pcfiledir}/../../../usr/include

# API info
api_version=1
host=x86_64-pc-linux-gnu

Name: gpgme
Description: GnuPG Made Easy (GPGME) is a C language library that allows to addsupport for cryptography to a program (deprecated)
Version: 1.13.1-unknown
Libs: -L${libdir} -lgpgme -lpthread
Cflags: -I${includedir}
Requires: libassuan gpg-error
