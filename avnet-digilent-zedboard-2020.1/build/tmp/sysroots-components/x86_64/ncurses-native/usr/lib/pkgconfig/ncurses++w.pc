prefix=${pcfiledir}/../../../usr
exec_prefix=${pcfiledir}/../../../usr
libdir=${pcfiledir}/../../../usr/lib
includedir=${pcfiledir}/../../../usr/include/ncursesw
abi_version=5
major_version=6
version=6.1.20190803

Name: ncurses++w
Description: ncurses 6.1 add-on library
